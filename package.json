{
    "name":  "hui-music",
    "version":  "1.0.0",
    "description":  "Local AI music radio with a React PWA, Node server, OpenAI voice, SQLite, QQ/LX imports, and LX music URL resolution.",
    "main":  "server/index.ts",
    "scripts":  {
                    "dev":  "tsx server/index.ts",
                    "dev:client":  "vite --host 127.0.0.1",
                    "build":  "vite build \u0026\u0026 tsc -p tsconfig.server.json --noEmit",
                    "preview":  "vite preview --host 127.0.0.1",
                    "test":  "vitest run",
                    "guardian:start":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-guardian.ps1",
                    "guardian:stop":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-guardian.ps1",
                    "guardian:restart":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-guardian.ps1"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "MIT",
    "type":  "module",
    "dependencies":  {
                         "@vitejs/plugin-react":  "^6.0.1",
                         "better-sqlite3":  "^12.9.0",
                         "cors":  "^2.8.6",
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "lucide-react":  "^1.14.0",
                         "node-cache":  "^5.1.2",
                         "openai":  "^6.36.0",
                         "p-limit":  "^7.3.0",
                         "react":  "^19.2.5",
                         "react-dom":  "^19.2.5",
                         "tsx":  "^4.21.0",
                         "typescript":  "^6.0.3",
                         "undici":  "^8.2.0",
                         "vite":  "^8.0.10",
                         "vitest":  "^4.1.5",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^25.6.0",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3"
                        }
}
